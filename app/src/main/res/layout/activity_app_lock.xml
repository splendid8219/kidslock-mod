<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/tv_margin_h">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="儿童锁屏"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="请输入打开密码"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle" />

        <!-- 密码点 -->
        <TextView
            android:id="@+id/tvPinDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○  ○  ○  ○"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_fill"
            android:letterSpacing="0.3"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_large" />

        <!-- 数字键盘 3x4 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1 2 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPin1"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="1"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
                <Button android:id="@+id/btnPin2"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="2"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
                <Button android:id="@+id/btnPin3"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="3"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- 4 5 6 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPin4"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="4"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
                <Button android:id="@+id/btnPin5"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="5"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
                <Button android:id="@+id/btnPin6"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="6"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- 7 8 9 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPin7"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="7"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
                <Button android:id="@+id/btnPin8"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="8"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
                <Button android:id="@+id/btnPin9"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="9"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- 清除 0 返回 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPinClear"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="清除"
                    android:textSize="@dimen/text_body"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
                <Button android:id="@+id/btnPin0"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="0"
                    android:textSize="@dimen/text_fill"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
                <Button android:id="@+id/btnPinBack"
                    android:layout_width="@dimen/btn_fill_width"
                    android:layout_height="@dimen/btn_fill_height"
                    android:layout_margin="@dimen/btn_fill_margin"
                    android:text="退出"
                    android:textSize="@dimen/text_body"
                    android:background="@drawable/btn_pin_bg"
                    android:textColor="@color/btn_text"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
